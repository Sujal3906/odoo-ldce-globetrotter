{
  "name": "globetrotter",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A collaborative multi-city travel planner",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --prefix backend\" \"npm run dev --prefix frontend\"",
    "server": "npm run dev --prefix backend",
